// ============================================
//   skf-files — файловая сила от SkyMonder
//   Чтение, запись, папки, пути, поиск
// ============================================


// --------------------------------------------
//   ЧТЕНИЕ И ЗАПИСЬ
// --------------------------------------------

функция прочитать_файл(путь) {
    // Читает весь файл как текст
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "r", encoding="utf-8")
        пусть содержимое = файл.read()
        файл.close()
        вернуть содержимое
    } поймать (ошибка) {
        бросить "Не удалось прочитать файл: " + ошибка
    }
}

функция прочитать_строки(путь) {
    // Читает файл и возвращает список строк (без \n)
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "r", encoding="utf-8")
        пусть строки = []
        для (строка в файл) {
            строки.добавить(строка.обрезать())
        }
        файл.close()
        вернуть строки
    } поймать (ошибка) {
        бросить "Не удалось прочитать файл: " + ошибка
    }
}

функция записать_файл(путь, текст) {
    // Перезаписывает файл (создаёт, если нет)
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "w", encoding="utf-8")
        файл.write(текст)
        файл.close()
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось записать файл: " + ошибка
    }
}

функция дописать_файл(путь, текст) {
    // Добавляет текст в конец файла
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "a", encoding="utf-8")
        файл.write(текст)
        файл.close()
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось дописать файл: " + ошибка
    }
}

функция прочитать_байты(путь) {
    // Читает файл в бинарном режиме
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "rb")
        пусть данные = файл.read()
        файл.close()
        вернуть данные
    } поймать (ошибка) {
        бросить "Не удалось прочитать файл: " + ошибка
    }
}

функция записать_байты(путь, данные) {
    // Пишет байты в файл
    подключить_питон("builtins")
    попробовать {
        пусть файл = open(путь, "wb")
        файл.write(данные)
        файл.close()
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось записать файл: " + ошибка
    }
}


// --------------------------------------------
//   ПРОВЕРКИ И ИНФОРМАЦИЯ
// --------------------------------------------

функция существует?(путь) {
    подключить_питон("os.path")
    вернуть os.path.exists(путь)
}

функция это_файл?(путь) {
    подключить_питон("os.path")
    вернуть os.path.isfile(путь)
}

функция это_папка?(путь) {
    подключить_питон("os.path")
    вернуть os.path.isdir(путь)
}

функция размер_файла(путь) {
    // Размер в байтах
    подключить_питон("os.path")
    попробовать {
        вернуть os.path.getsize(путь)
    } поймать (ошибка) {
        бросить "Не удалось получить размер: " + ошибка
    }
}

функция размер_читаемый(путь) {
    // Размер в человекочитаемом виде: Б, КБ, МБ, ГБ
    пусть байт = размер_файла(путь)
    если (байт < 1024) {
        вернуть байт + " Б"
    } иначе если (байт < 1024 * 1024) {
        вернуть округлить(байт / 1024, 2) + " КБ"
    } иначе если (байт < 1024 * 1024 * 1024) {
        вернуть округлить(байт / (1024 * 1024), 2) + " МБ"
    } иначе {
        вернуть округлить(байт / (1024 * 1024 * 1024), 2) + " ГБ"
    }
}

функция изменён(путь) {
    // Время последнего изменения (timestamp)
    подключить_питон("os.path")
    вернуть os.path.getmtime(путь)
}

функция создан(путь) {
    подключить_питон("os.path")
    вернуть os.path.getctime(путь)
}


// --------------------------------------------
//   ПАПКИ
// --------------------------------------------

функция создать_папку(путь) {
    // Создаёт папку и все промежуточные (как mkdir -p)
    подключить_питон("os")
    попробовать {
        os.makedirs(путь, exist_ok=истина)
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось создать папку: " + ошибка
    }
}

функция список_файлов(папка) {
    // Возвращает список имён файлов в папке
    подключить_питон("os")
    подключить_питон("os.path")
    попробовать {
        пусть всё = os.listdir(папка)
        пусть файлы = []
        для (имя в всё) {
            пусть полный = os.path.join(папка, имя)
            если (os.path.isfile(полный)) {
                файлы.добавить(имя)
            }
        }
        вернуть файлы
    } поймать (ошибка) {
        бросить "Не удалось прочитать папку: " + ошибка
    }
}

функция список_папок(папка) {
    подключить_питон("os")
    подключить_питон("os.path")
    попробовать {
        пусть всё = os.listdir(папка)
        пусть папки = []
        для (имя в всё) {
            пусть полный = os.path.join(папка, имя)
            если (os.path.isdir(полный)) {
                папки.добавить(имя)
            }
        }
        вернуть папки
    } поймать (ошибка) {
        бросить "Не удалось прочитать папку: " + ошибка
    }
}

функция всё_в_папке(папка) {
    // Всё содержимое папки (файлы + папки)
    подключить_питон("os")
    вернуть os.listdir(папка)
}

функция обойти(папка) {
    // Рекурсивно обходит папку, возвращает список всех файлов с путями
    подключить_питон("os")
    подключить_питон("os.path")
    пусть результат = []
    для (корень, папки, файлы в os.walk(папка)) {
        для (имя в файлы) {
            результат.добавить(os.path.join(корень, имя))
        }
    }
    вернуть результат
}


// --------------------------------------------
//   УДАЛЕНИЕ И ПЕРЕМЕЩЕНИЕ
// --------------------------------------------

функция удалить_файл(путь) {
    подключить_питон("os")
    попробовать {
        os.remove(путь)
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось удалить файл: " + ошибка
    }
}

функция удалить_папку(путь, рекурсивно) {
    // Если рекурсивно = истина, удаляет со всем содержимым
    подключить_питон("os")
    подключить_питон("shutil")
    попробовать {
        если (рекурсивно) {
            shutil.rmtree(путь)
        } иначе {
            os.rmdir(путь)
        }
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось удалить папку: " + ошибка
    }
}

функция копировать(откуда, куда) {
    подключить_питон("shutil")
    попробовать {
        shutil.copy2(откуда, куда)
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось скопировать: " + ошибка
    }
}

функция копировать_папку(откуда, куда) {
    подключить_питон("shutil")
    попробовать {
        shutil.copytree(откуда, куда)
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось скопировать папку: " + ошибка
    }
}

функция переместить(откуда, куда) {
    подключить_питон("shutil")
    попробовать {
        shutil.move(откуда, куда)
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось переместить: " + ошибка
    }
}

функция переименовать(путь, новое_имя) {
    подключить_питон("os")
    подключить_питон("os.path")
    пусть папка = os.path.dirname(путь)
    пусть новый_путь = os.path.join(папка, новое_имя)
    попробовать {
        os.rename(путь, новый_путь)
        вернуть новый_путь
    } поймать (ошибка) {
        бросить "Не удалось переименовать: " + ошибка
    }
}


// --------------------------------------------
//   ПУТИ
// --------------------------------------------

функция соединить(часть1, часть2) {
    // Склеивает части пути правильно для ОС
    подключить_питон("os.path")
    вернуть os.path.join(часть1, часть2)
}

функция имя_файла(путь) {
    // Возвращает имя файла из полного пути
    подключить_питон("os.path")
    вернуть os.path.basename(путь)
}

функция папка_пути(путь) {
    // Возвращает директорию пути
    подключить_питон("os.path")
    вернуть os.path.dirname(путь)
}

функция расширение(путь) {
    // Возвращает расширение файла (без точки)
    подключить_питон("os.path")
    вернуть os.path.splitext(путь)[1][1:]
}

функция имя_без_расширения(путь) {
    подключить_питон("os.path")
    вернуть os.path.splitext(os.path.basename(путь))[0]
}

функция абсолютный_путь(путь) {
    подключить_питон("os.path")
    вернуть os.path.abspath(путь)
}

функция текущая_папка() {
    подключить_питон("os")
    вернуть os.getcwd()
}


// --------------------------------------------
//   ПОИСК
// --------------------------------------------

функция найти_по_имени(папка, часть_имени) {
    // Ищет файлы, в имени которых есть подстрока
    пусть результат = []
    для (файл в обойти(папка)) {
        если (имя_файла(файл).содержит(часть_имени)) {
            результат.добавить(файл)
        }
    }
    вернуть результат
}

функция найти_по_расширению(папка, расш) {
    // Ищет файлы с указанным расширением
    пусть результат = []
    для (файл в обойти(папка)) {
        если (расширение(файл) == расш) {
            результат.добавить(файл)
        }
    }
    вернуть результат
}


// --------------------------------------------
//   JSON-ПОМОЩНИК (файловый)
// --------------------------------------------

функция прочитать_json(путь) {
    подключить_питон("json")
    пусть текст = прочитать_файл(путь)
    вернуть json.loads(текст)
}

функция записать_json(путь, данные, красиво) {
    подключить_питон("json")
    пусть текст = ничего
    если (красиво) {
        текст = json.dumps(данные, ensure_ascii=ложь, indent=2)
    } иначе {
        текст = json.dumps(данные, ensure_ascii=ложь)
    }
    вернуть записать_файл(путь, текст)
}
